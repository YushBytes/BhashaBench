# =============================================================================
# BhashaBench - Environment configuration template
# =============================================================================
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS / Linux:         cp .env.example .env
#
# NOTE: Phase 1 only consumes the Application and Database sections. The
# remaining variables are declared up front so that the configuration surface
# is stable, but they are not read by any code yet. Endpoint paths, auth
# schemes and request parameters for third-party providers are intentionally
# left unspecified until the phase that integrates them.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# APP_ENV: one of `development`, `staging`, `production`, `test`.
APP_ENV=development
APP_VERSION=0.1.0
# SECRET_KEY: used for signing. Generate a unique value per environment, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-generated-secret

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Local (host) development against the Docker Compose Postgres service.
#
# IMPORTANT: the port here must match POSTGRES_HOST_PORT below. If you change
# POSTGRES_HOST_PORT (commonly needed because another project already holds
# 5432) and forget to change it here, host-side tools - including
# `alembic upgrade head` - will connect to whatever else is listening on the
# old port. Migrating an unrelated database is a genuinely bad afternoon.
DATABASE_URL=postgresql+psycopg://bhashabench:change-me@localhost:5432/bhashabench
# From inside Docker Compose the host is the service name instead of localhost:
#   postgresql+psycopg://bhashabench:change-me@db:5432/bhashabench
#
# These three are read by the `db` service in docker-compose.yml.
POSTGRES_DB=bhashabench
POSTGRES_USER=bhashabench
POSTGRES_PASSWORD=change-me

# -----------------------------------------------------------------------------
# Host port bindings (Docker Compose only)
# -----------------------------------------------------------------------------
# Change these if a port is already in use on your machine - for example when
# another project is already running PostgreSQL on 5432. The ports *inside* the
# Compose network are fixed, so only your host-side access changes.
#
# If you change POSTGRES_HOST_PORT, update the port in DATABASE_URL above too.
POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000

# -----------------------------------------------------------------------------
# Transcription / speech to text (Phase 4)
# -----------------------------------------------------------------------------
# Which speech-to-text provider to use.
#   fake    - offline test double. Returns scripted transcripts, needs no
#             credentials, and is REFUSED when APP_ENV=production.
#   prisma  - Gnani Prisma. Requires GNANI_API_KEY below.
# Defaults to `fake` so a fresh checkout starts and tests without credentials.
TRANSCRIPTION_PROVIDER=fake

# Per-request timeout for a provider call, in seconds.
TRANSCRIPTION_TIMEOUT_SECONDS=30

# Total attempts per batch transcription, including the first. 1 disables
# retrying. Only transient failures (5xx, 429, timeouts, reset connections)
# are retried; a 401 or invalid audio never is. Streaming is never retried
# automatically, because the audio has already been consumed.
TRANSCRIPTION_MAX_ATTEMPTS=3
TRANSCRIPTION_INITIAL_BACKOFF_SECONDS=0.5
# Ceiling on any retry delay, including one a provider asks for via
# Retry-After. Without it a provider could make the API appear to hang.
TRANSCRIPTION_MAX_BACKOFF_SECONDS=8

# Largest audio payload accepted by POST /api/v1/transcription, in bytes.
# The effective limit is the lower of this and the provider's own (Gnani
# documents 10 MB per file for its batch API).
TRANSCRIPTION_MAX_UPLOAD_BYTES=10485760

# Opt in to tests that make REAL, BILLABLE provider calls. Leave false in CI.
TRANSCRIPTION_LIVE_TESTS=false

# -----------------------------------------------------------------------------
# Gnani platform (Prisma STT / Timbre TTS / Evon reasoning)
# -----------------------------------------------------------------------------
# Obtain an API key from your Gnani account dashboard at app.gnani.ai. It is
# sent as the `X-API-Key-ID` request header - not as a Bearer token.
# NEVER commit a real value here. This file is tracked; `.env` is not.
GNANI_API_KEY=

# REST base URL. The documented default is below; the WebSocket URL for
# streaming is derived from it by swapping the scheme to wss://.
GNANI_API_BASE_URL=https://api.vachana.ai

# Prisma model identifier: `prisma-v3.0` or `prisma-v2.5`. v3.0 is the model
# documented for code-mixed Indian call audio.
GNANI_STT_MODEL=prisma-v3.0

# -----------------------------------------------------------------------------
# Speech synthesis / text to speech (Phase 5)
# -----------------------------------------------------------------------------
# Which text-to-speech provider to use.
#   fake    - offline test double. Returns a synthesised tone, needs no
#             credentials, and is REFUSED when APP_ENV=production.
#   timbre  - Gnani Timbre. Uses the same GNANI_API_KEY as Prisma above; the
#             vendor documents one key and one X-API-Key-ID header across the
#             platform, so there is deliberately no second TTS credential.
#             Note that one key does not guarantee both scopes: a 403 here on
#             a key that works for Prisma means the TTS scope is missing.
SPEECH_PROVIDER=fake

# Per-request timeout in seconds. Higher than the transcription default:
# rendering a long utterance takes longer than recognising a short one.
SPEECH_TIMEOUT_SECONDS=60

# Total attempts per synthesis, including the first. 1 disables retrying.
# Only transient failures (5xx, 429, timeouts, reset connections) are retried;
# 401/402/403 and rejected parameters never are.
SPEECH_MAX_ATTEMPTS=3
SPEECH_INITIAL_BACKOFF_SECONDS=0.5
SPEECH_MAX_BACKOFF_SECONDS=8

# Longest text accepted for synthesis. This is BhashaBench's own bound - the
# provider publishes no limit of its own, so one request could otherwise cost
# an unbounded amount.
SPEECH_MAX_TEXT_CHARS=5000

# Timbre model: `timbre-v3.0` or `timbre-v2.5`. v3.0 has 13 voices that each
# speak all ten supported languages, plus inline expression tags.
GNANI_TTS_MODEL=timbre-v3.0

# Default voice when a request names none. One of the 13 documented v3.0
# voices - see GET /api/v1/speech/providers for the full list with the
# character each is catalogued for.
GNANI_TTS_VOICE=Kalpana

# Opt in to tests that make REAL, BILLABLE synthesis calls. Separate from
# TRANSCRIPTION_LIVE_TESTS so enabling one does not silently enable the other.
SPEECH_LIVE_TESTS=false

# Evon (reasoning, Phase 6) reads no settings yet. Its variables will be added
# in its own phase rather than sitting here unread - see
# docs/DEVELOPMENT_ROADMAP.md.

# -----------------------------------------------------------------------------
# Twilio (telephony / bidirectional media streaming)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 format, e.g. +918000000000
TWILIO_FROM_NUMBER=

# -----------------------------------------------------------------------------
# Public addressing
# -----------------------------------------------------------------------------
# Externally reachable base URL for webhooks and media callbacks. During local
# development this is typically a tunnel (ngrok, Cloudflare Tunnel, ...).
PUBLIC_BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Caller engine (Phase 6)
# -----------------------------------------------------------------------------
# Phase 6 uses deterministic, rule-based caller orchestration. Official Gnani
# Evon integration is deferred until documented access and credentials are
# available. There is no Evon credential to set here, and `evon` is not a valid
# CALLER_PROVIDER value - the API would refuse it by name.
#
# 'deterministic' is the only provider: a rule engine, not a language model.
CALLER_PROVIDER=deterministic
# Hard ceiling on conversation turns, applied on top of a scenario's own
# goal.max_turns. The lower of the two wins, so no scenario can ask for an
# unbounded conversation.
CALLER_MAX_TURNS=20
# How many times the caller presses for a usable answer before closing the
# conversation as making no progress.
CALLER_MAX_CLARIFICATIONS=2
# Longest caller utterance accepted from a provider, in characters. Bounded
# separately from the speech limit so a runaway decision is caught before it
# reaches synthesis.
CALLER_MAX_MESSAGE_CHARS=600
# Ceiling on one full turn, including synthesis and transcription.
CALLER_TURN_TIMEOUT_SECONDS=90.0
# Directory for conversation audio. `storage/` is already git-ignored; audio
# stays on disk and only a relative reference is stored in the database.
CALLER_AUDIO_STORAGE_DIR=./storage/caller-audio
# Whether to synthesise caller audio for each turn. Off by default: with
# SPEECH_PROVIDER=timbre every turn becomes a billable call, so enabling this
# is a deliberate act.
CALLER_SYNTHESISE_AUDIO=false

# -----------------------------------------------------------------------------
# Safety limits and guardrails
# -----------------------------------------------------------------------------
# Hard caps that bound cost and blast radius of an automated test run.
MAX_CALLS_PER_RUN=10
MAX_MINUTES_PER_DAY=60
MAX_CONCURRENT_CALLS=2
# Comma-separated E.164 allow-list. Only these numbers may ever be dialled.
# An empty value must be treated as "no number is dialable".
ALLOWED_BOT_NUMBERS=

# -----------------------------------------------------------------------------
# Audio, degradation and evaluation
# -----------------------------------------------------------------------------
# Filesystem location for recorded and generated audio artefacts.
AUDIO_STORAGE_PATH=./storage/audio
# Master seed for the audio degradation pipeline, so noise is reproducible.
NOISE_MASTER_SEED=42
# Retry budget for an evaluation ("judge") call before the turn is failed.
JUDGE_RETRIES=2
# Score in [0.0, 1.0] at or above which a scenario counts as passing.
PASS_THRESHOLD=0.7
