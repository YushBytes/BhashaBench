# =============================================================================
# BhashaBench - Environment configuration template
# =============================================================================
# Copy this file to `.env` and fill in real values. `.env` is git-ignored.
#
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS / Linux:         cp .env.example .env
#
# NOTE: Phase 1 only consumes the Application and Database sections. The
# remaining variables are declared up front so that the configuration surface
# is stable, but they are not read by any code yet. Endpoint paths, auth
# schemes and request parameters for third-party providers are intentionally
# left unspecified until the phase that integrates them.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
# APP_ENV: one of `development`, `staging`, `production`, `test`.
APP_ENV=development
APP_VERSION=0.1.0
# SECRET_KEY: used for signing. Generate a unique value per environment, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-generated-secret

# -----------------------------------------------------------------------------
# HTTP hardening (Phase 14 part 2). 0 disables a limit. Windows are per process.
# -----------------------------------------------------------------------------
# `text` (readable) or `json` (one object per line, with the request id).
LOG_FORMAT=text
# Bearer token for GET /metrics (Prometheus text). Empty turns it off (404).
METRICS_TOKEN=
RATE_LIMIT_REQUESTS_PER_MINUTE=600
RATE_LIMIT_LOGINS_PER_MINUTE=10
# Key limits by X-Forwarded-For. ONLY behind a proxy that overwrites it.
TRUST_FORWARDED_FOR=false

# -----------------------------------------------------------------------------
# Authentication (Phase 14)
# -----------------------------------------------------------------------------
# scrypt cost as log2 N. 17 is the minimum staging and production accept.
AUTH_PASSWORD_HASH_LOG2_N=17
# Absolute session lifetime (hours) and idle timeout (minutes).
AUTH_SESSION_TTL_HOURS=12
AUTH_SESSION_IDLE_MINUTES=60
# Consecutive failed logins before a lockout, and its length in minutes.
AUTH_MAX_FAILED_LOGINS=10
AUTH_LOCKOUT_MINUTES=15
# Open self-service sign-up. Off: create the first user with
#   bhashabench users create --email you@example.com --workspace my-team
AUTH_ALLOW_SIGNUP=false

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Local (host) development against the Docker Compose Postgres service.
#
# IMPORTANT: the port here must match POSTGRES_HOST_PORT below. If you change
# POSTGRES_HOST_PORT (commonly needed because another project already holds
# 5432) and forget to change it here, host-side tools - including
# `alembic upgrade head` - will connect to whatever else is listening on the
# old port. Migrating an unrelated database is a genuinely bad afternoon.
DATABASE_URL=postgresql+psycopg://bhashabench:change-me@localhost:5432/bhashabench
# From inside Docker Compose the host is the service name instead of localhost:
#   postgresql+psycopg://bhashabench:change-me@db:5432/bhashabench
#
# These three are read by the `db` service in docker-compose.yml.
POSTGRES_DB=bhashabench
POSTGRES_USER=bhashabench
POSTGRES_PASSWORD=change-me

# -----------------------------------------------------------------------------
# Host port bindings (Docker Compose only)
# -----------------------------------------------------------------------------
# Change these if a port is already in use on your machine - for example when
# another project is already running PostgreSQL on 5432. The ports *inside* the
# Compose network are fixed, so only your host-side access changes.
#
# If you change POSTGRES_HOST_PORT, update the port in DATABASE_URL above too.
POSTGRES_HOST_PORT=5432
BACKEND_HOST_PORT=8000
FRONTEND_HOST_PORT=3000

# -----------------------------------------------------------------------------
# Browser access
# -----------------------------------------------------------------------------
# Origins the API trusts. Comma-separated. Since Phase 14 the browser calls
# the frontend's own /api/v1 (proxied to the backend), and the API refuses a
# cookie-authenticated write whose Origin is not listed here - so the origin
# the frontend is served from MUST be in this list, or every sign-out and
# every "start run" fails with 403.
CORS_ORIGINS=http://localhost:3000

# Where the frontend's server reaches the backend: the target of the
# /api/v1 proxy and of server-component fetches. Compiled into the
# rewrites when `next build` runs; http://backend:8000 under Compose.
BACKEND_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Transcription / speech to text (Phase 4)
# -----------------------------------------------------------------------------
# Which speech-to-text provider to use.
#   fake    - offline test double. Returns scripted transcripts, needs no
#             credentials, and is REFUSED when APP_ENV=production.
#   prisma  - Gnani Prisma. Requires GNANI_API_KEY below.
# Defaults to `fake` so a fresh checkout starts and tests without credentials.
TRANSCRIPTION_PROVIDER=fake

# Per-request timeout for a provider call, in seconds.
TRANSCRIPTION_TIMEOUT_SECONDS=30

# Total attempts per batch transcription, including the first. 1 disables
# retrying. Only transient failures (5xx, 429, timeouts, reset connections)
# are retried; a 401 or invalid audio never is. Streaming is never retried
# automatically, because the audio has already been consumed.
TRANSCRIPTION_MAX_ATTEMPTS=3
TRANSCRIPTION_INITIAL_BACKOFF_SECONDS=0.5
# Ceiling on any retry delay, including one a provider asks for via
# Retry-After. Without it a provider could make the API appear to hang.
TRANSCRIPTION_MAX_BACKOFF_SECONDS=8

# Largest audio payload accepted by POST /api/v1/transcription, in bytes.
# The effective limit is the lower of this and the provider's own (Gnani
# documents 10 MB per file for its batch API).
TRANSCRIPTION_MAX_UPLOAD_BYTES=10485760

# Opt in to tests that make REAL, BILLABLE provider calls. Leave false in CI.
TRANSCRIPTION_LIVE_TESTS=false

# -----------------------------------------------------------------------------
# Gnani platform (Prisma STT / Timbre TTS / Evon reasoning)
# -----------------------------------------------------------------------------
# Obtain an API key from your Gnani account dashboard at app.gnani.ai. It is
# sent as the `X-API-Key-ID` request header - not as a Bearer token.
# NEVER commit a real value here. This file is tracked; `.env` is not.
GNANI_API_KEY=

# REST base URL. The documented default is below; the WebSocket URL for
# streaming is derived from it by swapping the scheme to wss://.
GNANI_API_BASE_URL=https://api.vachana.ai

# Prisma model identifier: `prisma-v3.0` or `prisma-v2.5`. v3.0 is the model
# documented for code-mixed Indian call audio.
GNANI_STT_MODEL=prisma-v3.0

# -----------------------------------------------------------------------------
# Speech synthesis / text to speech (Phase 5)
# -----------------------------------------------------------------------------
# Which text-to-speech provider to use.
#   fake    - offline test double. Returns a synthesised tone, needs no
#             credentials, and is REFUSED when APP_ENV=production.
#   timbre  - Gnani Timbre. Uses the same GNANI_API_KEY as Prisma above; the
#             vendor documents one key and one X-API-Key-ID header across the
#             platform, so there is deliberately no second TTS credential.
#             Note that one key does not guarantee both scopes: a 403 here on
#             a key that works for Prisma means the TTS scope is missing.
SPEECH_PROVIDER=fake

# Per-request timeout in seconds. Higher than the transcription default:
# rendering a long utterance takes longer than recognising a short one.
SPEECH_TIMEOUT_SECONDS=60

# Total attempts per synthesis, including the first. 1 disables retrying.
# Only transient failures (5xx, 429, timeouts, reset connections) are retried;
# 401/402/403 and rejected parameters never are.
SPEECH_MAX_ATTEMPTS=3
SPEECH_INITIAL_BACKOFF_SECONDS=0.5
SPEECH_MAX_BACKOFF_SECONDS=8

# Longest text accepted for synthesis. This is BhashaBench's own bound - the
# provider publishes no limit of its own, so one request could otherwise cost
# an unbounded amount.
SPEECH_MAX_TEXT_CHARS=5000

# Timbre model: `timbre-v3.0` or `timbre-v2.5`. v3.0 has 13 voices that each
# speak all ten supported languages, plus inline expression tags.
GNANI_TTS_MODEL=timbre-v3.0

# Default voice when a request names none. One of the 13 documented v3.0
# voices - see GET /api/v1/speech/providers for the full list with the
# character each is catalogued for.
GNANI_TTS_VOICE=Kalpana

# Opt in to tests that make REAL, BILLABLE synthesis calls. Separate from
# TRANSCRIPTION_LIVE_TESTS so enabling one does not silently enable the other.
SPEECH_LIVE_TESTS=false

# Evon (reasoning, Phase 6) reads no settings yet. Its variables will be added
# in its own phase rather than sitting here unread - see
# docs/DEVELOPMENT_ROADMAP.md.

# -----------------------------------------------------------------------------
# Telephony (Phase 8) - a MOCKED provider only; no real call can be placed
# -----------------------------------------------------------------------------
# Empty = off. `mock` is the only provider; it dials nothing and every call it
# produces is labelled mocked. It is refused when APP_ENV=production.
TELEPHONY_PROVIDER=
# Signs provider events; at least 32 characters or nothing verifies.
TELEPHONY_WEBHOOK_SECRET=
# Comma-separated E.164 bot numbers. Empty allows no call at all.
TELEPHONY_ALLOWED_NUMBERS=
TELEPHONY_MAX_CALLS_PER_RUN=3
TELEPHONY_MAX_CONCURRENT_CALLS=1
TELEPHONY_MAX_MINUTES_PER_DAY=30

# Twilio - NOT READ BY ANYTHING. No Twilio adapter exists (a paid number and
# per-minute calls are not authorised). Kept to document what one would need.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# E.164 format, e.g. +918000000000
TWILIO_FROM_NUMBER=

# -----------------------------------------------------------------------------
# Public addressing
# -----------------------------------------------------------------------------
# Externally reachable base URL for webhooks and media callbacks. During local
# development this is typically a tunnel (ngrok, Cloudflare Tunnel, ...).
PUBLIC_BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Caller engine (Phase 6)
# -----------------------------------------------------------------------------
# Phase 6 uses deterministic, rule-based caller orchestration. Official Gnani
# Evon integration is deferred until documented access and credentials are
# available. There is no Evon credential to set here, and `evon` is not a valid
# CALLER_PROVIDER value - the API would refuse it by name.
#
# 'deterministic' is a rule engine, not a language model, and is the default.
# 'sarvam' asks a Sarvam model for each turn and falls back to the rule engine
# (see the language-model caller section below). While live calls are
# unauthorised it can only fall back, and every turn's evidence says so.
CALLER_PROVIDER=deterministic
# Hard ceiling on conversation turns, applied on top of a scenario's own
# goal.max_turns. The lower of the two wins, so no scenario can ask for an
# unbounded conversation.
CALLER_MAX_TURNS=20
# How many times the caller presses for a usable answer before closing the
# conversation as making no progress.
CALLER_MAX_CLARIFICATIONS=2
# Longest caller utterance accepted from a provider, in characters. Bounded
# separately from the speech limit so a runaway decision is caught before it
# reaches synthesis.
CALLER_MAX_MESSAGE_CHARS=600
# Ceiling on one full turn, including synthesis and transcription.
CALLER_TURN_TIMEOUT_SECONDS=90.0
# Directory for conversation audio. `storage/` is already git-ignored; audio
# stays on disk and only a relative reference is stored in the database.
CALLER_AUDIO_STORAGE_DIR=./storage/caller-audio
# Where artefacts are kept. `local` is the only backend: files under the
# directory above. Anything else fails at startup with the reason.
STORAGE_BACKEND=local
# Days after a run finishes before `bhashabench runs purge --apply` deletes it
# with its evidence and audio. Empty keeps everything. Nothing is ever deleted
# on a timer: the sweep runs only when invoked, and only with --apply.
RETENTION_DAYS=
# Whether to synthesise caller audio for each turn. Off by default: with
# SPEECH_PROVIDER=timbre every turn becomes a billable call, so enabling this
# is a deliberate act.
CALLER_SYNTHESISE_AUDIO=false

# -----------------------------------------------------------------------------
# Language-model caller (Phase 6) — Sarvam
# -----------------------------------------------------------------------------
# STATUS: implemented from Sarvam's published documentation and tested offline
# only. NOT verified against the live service. LIVE TESTING IS NOT AUTHORISED.
#
# Nothing in this section can cause a billable request. A live call needs all
# of: the code-level authorisation in backend/app/caller/llm/budget.py
# (LIVE_CALLS_AUTHORISED, a constant that is False and is not a setting),
# CALLER_LLM_LIVE_CALLS_ENABLED=true, a key, and a non-zero budget. Setting the
# values below does not grant the first of those.
#
# Sarvam API key, sent as the `api-subscription-key` header. Leave empty here;
# a real key belongs only in your git-ignored .env.
SARVAM_API_KEY=
# Sarvam REST base URL. Must be https - the request carries the key.
SARVAM_API_BASE_URL=https://api.sarvam.ai
# Exact model for CALLER_PROVIDER=sarvam: `sarvam-105b` (128K context,
# reasoning documented) or `sarvam-105b-conversations` (32K context, reasoning
# not documented). No default: the model a benchmark ran on is chosen, never
# assumed, and it is recorded on every generated turn.
CALLER_LLM_MODEL=
# Operator switch for live calls. Necessary, not sufficient (see above).
CALLER_LLM_LIVE_CALLS_ENABLED=false
# Total rupees live calls may commit across every run and restart, tracked in
# the ledger below. Zero means nothing can be spent. The hard maximum is 100
# and a larger value is rejected at startup.
CALLER_LLM_LIVE_BUDGET_INR=0
# Where the spending ledger is kept. `storage/` is git-ignored. Deleting the
# file resets the count, so the provider's dashboard remains the authority.
CALLER_LLM_BUDGET_LEDGER_PATH=./storage/llm-budget/ledger.json
# Most one conversation may commit, worst case, in rupees.
CALLER_LLM_MAX_COST_PER_RUN_INR=5
# Fraction added to Sarvam's published token prices, which exclude GST. 0.18
# is this project's allowance for that tax, not a vendor figure.
CALLER_LLM_COST_MARGIN=0.18
# Most tokens one generated turn may produce (reasoning tokens count toward
# it), and the most one prompt may hold, measured as an upper bound.
CALLER_LLM_MAX_OUTPUT_TOKENS=300
CALLER_LLM_MAX_PROMPT_TOKENS=8000
# Total requests allowed for one turn, counting every kind of failure. After
# that the rule engine supplies the turn and the reason is recorded.
CALLER_LLM_MAX_ATTEMPTS=2
CALLER_LLM_REQUEST_TIMEOUT_SECONDS=30.0
# Always sent explicitly: Sarvam's documented default is contradictory.
CALLER_LLM_TEMPERATURE=0.5
# Optional seed. Best-effort by Sarvam's own description; recorded as sent,
# never as honoured. Leave empty for none.
CALLER_LLM_SEED=
# Reasoning effort for `sarvam-105b`: low, medium, high or max. Empty disables
# reasoning (the default: it is billed as output). Must be empty for
# `sarvam-105b-conversations`.
CALLER_LLM_REASONING_EFFORT=

# -----------------------------------------------------------------------------
# Pipeline (Phase 7) — end-to-end voice testing
# -----------------------------------------------------------------------------
# Which bot adapter a run uses by default. 'scripted' replays fixture audio and
# 'manual' waits for an operator to post the bot's reply. Neither sends a
# request anywhere, which is why one of them is the default - the default
# configuration must not send audio to an external destination.
# There is no adapter for a real voice bot: writing one means implementing it
# against that bot's published interface. This project does not invent one.
PIPELINE_BOT_ADAPTER=scripted

# -- HTTP text bot (bot_adapter=http, mode=text_bot_test) ----------------------
# A bot speaking bhashabench-text-bot/1 (docs/BOT_PROTOCOL.md). The allowlist is
# empty by default, so no bot is reachable until you name its host. For the
# local reference bot (python -m reference_bot, from backend/):
#   BOT_HTTP_BASE_URL=http://127.0.0.1:8090
#   BOT_HTTP_ALLOWED_HOSTS=127.0.0.1
#   BOT_HTTP_ALLOW_LOOPBACK=true      (refused when APP_ENV is staging/production)
BOT_HTTP_BASE_URL=
BOT_HTTP_TOKEN=<bot bearer token - never commit a real value>
BOT_HTTP_ALLOWED_HOSTS=
BOT_HTTP_ALLOW_LOOPBACK=false
BOT_HTTP_ALLOW_PRIVATE=false
# Plain http/ws to a private-network bot (a container on the same Docker
# network). Needs ALLOW_PRIVATE too; refused when APP_ENV is staging/production.
BOT_HTTP_ALLOW_PLAIN_PRIVATE=false
BOT_HTTP_TIMEOUT_SECONDS=10
BOT_HTTP_MAX_ATTEMPTS=2
# REFERENCE_BOT_TOKEN=<16+ characters; the reference bot's own token>
# A WAV the 'scripted' adapter replays as the bot's reply on every turn.
#
# UNSET BY DEFAULT, and unset means the original behaviour exactly: a scripted
# run started through the API has no replies and fails with "the scripted bot
# has no reply for turn 0". Setting it is what makes `audio_fixture_test`
# complete end to end, which is how the demonstration run works - see
# docs/COMPETITION_DEMO_SCRIPT.md.
#
# The audio is a fixture, NOT a bot. The scripted adapter reports
# `received_from_bot=false`, so the run's `bot_audio_externally_received` stays
# false and a fixture run can never be mistaken for a test against a real bot.
# This is an operator setting read from the environment; no client value
# reaches it, so it is not a path a request can choose.
# PIPELINE_FIXTURE_AUDIO_PATH=backend/tests/fixtures/audio/tone_8k_mono.wav
# Bot replies as text, one per line, for `offline_simulation` with the
# 'scripted' adapter. Used in order and repeated when exhausted. Unset, an
# offline scripted run fails on its first bot turn with an error naming this
# setting. Operator setting; no client value reaches it.
# PIPELINE_FIXTURE_BOT_TEXT_PATH=backend/tests/fixtures/bot_text/cooperative_en.txt
# Wall-clock ceiling on one whole run, on top of the per-turn timeout. A run
# that hangs holds a database session.
PIPELINE_RUN_TIMEOUT_SECONDS=600.0
# How often the server closes runs left in flight with nothing executing them
# (a crash, a restart). 0 disables it. A run is stale after
# PIPELINE_RUN_TIMEOUT_SECONDS of inactivity plus a minute.
PIPELINE_RECOVERY_INTERVAL_SECONDS=300
# ws:// or wss:// URL of a bot speaking bhashabench-voice-bot/1, for the
# `ws_voice` adapter. Uses BOT_HTTP_TOKEN and BOT_HTTP_ALLOWED_HOSTS.
BOT_WS_URL=
# How many runs may execute at once. Bounds provider spend and memory: each
# turn decodes audio into Python lists.
PIPELINE_MAX_CONCURRENT_RUNS=2
# Default seed for audio degradation. Fixed so a run is reproducible by
# default - an artefact nobody can reproduce is not evidence.
PIPELINE_NOISE_SEED=42
# Degradation profile for runs that do not name one. A scenario's own declared
# acoustic environment takes precedence. One of: clean, telephony_bandwidth,
# light_background_noise, moderate_background_noise, heavy_background_noise.
PIPELINE_NOISE_PROFILE=clean
# PIPELINE_SERVE_ARTEFACTS was retired in Phase 10: stored audio is served to
# whoever holds the viewer role in the run's workspace, or a signed link one
# of them minted (POST /test-runs/{id}/audio-links), in every environment.
# A leftover value in an old .env is ignored.

# -----------------------------------------------------------------------------
# Safety limits and guardrails
# -----------------------------------------------------------------------------
# Hard caps that bound cost and blast radius of an automated test run.
MAX_CALLS_PER_RUN=10
MAX_MINUTES_PER_DAY=60
MAX_CONCURRENT_CALLS=2
# Comma-separated E.164 allow-list. Only these numbers may ever be dialled.
# An empty value must be treated as "no number is dialable".
ALLOWED_BOT_NUMBERS=

# -----------------------------------------------------------------------------
# Audio, degradation and evaluation
# -----------------------------------------------------------------------------
# Filesystem location for recorded and generated audio artefacts.
AUDIO_STORAGE_PATH=./storage/audio
# Master seed for the audio degradation pipeline, so noise is reproducible.
NOISE_MASTER_SEED=42
# Retry budget for an evaluation ("judge") call before the turn is failed.
JUDGE_RETRIES=2
# Score in [0.0, 1.0] at or above which a scenario counts as passing.
PASS_THRESHOLD=0.7
