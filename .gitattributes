# Normalise line endings: the repository stores LF, Windows checkouts may use
# CRLF locally. Files consumed by Linux containers are pinned to LF so that
# they remain executable/parsable inside Docker regardless of host platform.
* text=auto eol=lf

Dockerfile      text eol=lf
*.sh            text eol=lf
*.py            text eol=lf
*.ts            text eol=lf
*.tsx           text eol=lf
*.json          text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
*.toml          text eol=lf
*.md            text eol=lf

# Binary assets must never be line-ending converted.
*.png binary
*.jpg binary
*.ico binary
*.wav binary
*.mp3 binary
