# ---------------------------------------------------------------------------
# Database dumps and backups
# ---------------------------------------------------------------------------
# A dump taken from a real environment contains real data, so these must never
# be committed by accident. Targeted patterns rather than a blanket `*.sql`,
# so a deliberately reviewed statement file - `alembic upgrade head --sql`
# output, for instance - can still be added on purpose.
*.dump
*.sql.gz
*.sql.bz2
*.sql.xz
*.sql.zip
dump.sql
*-dump.sql
*_dump.sql
pg_dump*.sql
*.bak
backup/
backups/

# ---------------------------------------------------------------------------
# Runtime artefacts (generated by later phases)
# ---------------------------------------------------------------------------
storage/
audio_storage/
*.wav
*.mp3
*.ogg
*.log
logs/

# ---------------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------------
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
