# Keep build contexts small and prevent host artefacts or secrets from being
# copied into images.
.git/
.gitignore
.github/

.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
htmlcov/
.coverage

# Node
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/

# Runtime artefacts
storage/
logs/
*.log

# Docs and editor files are not needed at build time.
docs/
*.md
!README.md
.vscode/
.idea/
